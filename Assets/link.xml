  <!--
    Json.NET resolves contracts through reflection, so neither it nor the DTOs it fills may be stripped.
    Unlike JsonUtility the linker cannot see these members, and a stripped field turns into silently
    missing data in the WebGL build rather than an exception. Every assembly holding a type that Json.NET
    deserializes belongs here; add new assembly definitions to this list when they are created.
  -->
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="WordOnline.Serialization" preserve="all" />
  <assembly fullname="WordOnline.GameContracts" preserve="all" />
  <assembly fullname="WordOnline.Contracts" preserve="all" />
  <assembly fullname="WordOnline.Net" preserve="all" />
