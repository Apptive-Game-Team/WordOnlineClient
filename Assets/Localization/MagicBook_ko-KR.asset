  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: MagicBook_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: a5fb4d045cc352340a0b295aafdb7db4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1000000
    m_Localized: "\uC791\uC740 \uBB3C \uC2AC\uB77C\uC784 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000001
    m_Localized: "\uBD88\uAF43 \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000002
    m_Localized: "\uAC04\uD5D0\uCC9C\uC744 \uC18C\uD658\uD574 \uD53C\uD574\uB97C
      \uC8FC\uACE0 \uACF5\uC911\uC73C\uB85C \uB744\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000003
    m_Localized: "\uC9C0\uC0C1\uC720\uB2DB\uC744 \uACF5\uACA9\uD558\uB294 \uB300\uD3EC\uB97C
      \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000004
    m_Localized: "\uACF5\uC911\uC720\uB2DB\uC744 \uBC94\uC704 \uACF5\uACA9\uD558\uB294
      \uD0C0\uC6CC\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000005
    m_Localized: "\uB9C8\uB098\uB97C \uD68C\uBCF5\uD558\uB294 \uC6B0\uBB3C\uC744
      \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000006
    m_Localized: "\uC9C0\uC0C1\uACFC \uACF5\uC911 \uC720\uB2DB\uC744 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uD558\uB294 \uAD81\uC218\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000007
    m_Localized: "\uD06C\uACE0 \uB2E8\uB2E8\uD55C \uBC14\uC704 \uACE8\uB818\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000008
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uB97C \uC6B0\uC120 \uACF5\uACA9\uD558\uB294
      \uD3ED\uD48D \uAE30\uC218\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000009
    m_Localized: "\uBE60\uB974\uACE0 \uACF5\uC911\uC744 \uB0A0\uC544\uB2E4\uB2C8\uB294
      \uCC9C\uB465 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000010
    m_Localized: "\uC8FC\uBCC0\uC744 \uBD88\uD0DC\uC6B0\uACE0 \uC801\uB4E4\uC744
      \uBD88\uD0DC\uC6B0\uB294 \uBD88\uAF43 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000011
    m_Localized: "\uB099\uB8B0\uB97C \uC18C\uD658\uD574 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000012
    m_Localized: "\uC801\uB4E4\uC744 \uBD88\uD0DC\uC6B0\uB294 \uB9C8\uADF8\uB9C8
      \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000013
    m_Localized: "\uC544\uAD70\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uB294 \uD1A0\uD15C\uC744
      \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000014
    m_Localized: "\uBAA8\uB798 \uD3ED\uD48D\uC744 \uC77C\uC73C\uCF1C \uC801\uC744
      \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000015
    m_Localized: "\uD68C\uC624\uB9AC\uBC14\uB78C\uC73C\uB85C \uC801\uB4E4\uC744 \uC4F8\uC5B4\uBC84\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000016
    m_Localized: "\uB113\uC740 \uBC94\uC704\uC5D0 \uC6B4\uC11D\uB4E4\uC744 \uB5A8\uC5B4\uD2B8\uB824
      \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000017
    m_Localized: "\uC8FC\uBCC0\uC744 \uCD95\uCD95\uD558\uAC8C \uD558\uB294 \uC6B4\uB8E1\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000018
    m_Localized: "\uB3CC\uC9C4\uD574\uC11C \uACF5\uACA9\uD558\uB294 \uCC9C\uB465\uC0C8
      \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000019
    m_Localized: "\uD06C\uACE0 \uB2E4\uC18C \uB290\uB9B0 \uB098\uBB34 \uACE8\uB818\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000020
    m_Localized: "\uB369\uAD74\uC758 \uD798\uC744 \uAC00\uC9C4 \uC815\uB839\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000021
    m_Localized: "\uB369\uAD74\uB85C \uC801\uB4E4\uC744 \uD1F4\uCE58\uD558\uB294
      \uC2DD\uBB3C\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000022
    m_Localized: "\uB450\uAC1C\uC758 \uBC14\uC704\uB85C \uC801\uB4E4\uC744 \uD0C0\uACA9\uD558\uB294
      \uB9C8\uBC95\uC0AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000023
    m_Localized: "\uC791\uC740 \uC528\uC557 \uC815\uB839 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000024
    m_Localized: "\uC791\uC740 \uBD88\uC528 \uC815\uB839 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000025
    m_Localized: "\uC791\uC740 \uBC14\uC704 \uC30D\uB465\uC774\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000026
    m_Localized: "\uC801\uB4E4\uC744 \uD5A5\uD574 \uC790\uD3ED \uACF5\uACA9\uC744
      \uD558\uB294 \uBC14\uB78C \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000027
    m_Localized: "\uB728\uAC70\uC6B4 \uB9C8\uADF8\uB9C8 \uD3ED\uBC1C\uC744 \uC77C\uC73C\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000028
    m_Localized: "\uC801\uB4E4\uC744 \uC77C\uC815\uD55C \uBC29\uD5A5\uC73C\uB85C
      \uB0A0\uB824\uBC84\uB9AC\uB294 \uBC14\uB78C \uD1A0\uD15C\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000029
    m_Localized: "\uBC14\uC704\uB97C \uBC1C\uC0AC\uD558\uB294 \uC791\uC740 \uD3EC\uD0D1\uC744
      \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000030
    m_Localized: "\uC8FC\uBCC0\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uB294 \uC0DD\uBA85\uC758
      \uB098\uBB34\uB97C \uC2EC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000031
    m_Localized: "\uAD00\uD1B5\uD558\uB294 \uB0A0\uCE74\uB85C\uC6B4 \uBC14\uB78C
      \uCE7C\uB0A0\uC744 \uB0A0\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000032
    m_Localized: "\uB369\uAD74\uC744 \uC77C\uB82C\uB85C \uC18C\uD658\uD574 \uC801\uC744
      \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000033
    m_Localized: "\uBC00\uB824\uC624\uB294 \uBB3C\uACB0\uB85C \uC801\uB4E4\uC744
      \uBC00\uCCD0\uB0B4\uBA70 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000034
    m_Localized: "\uC801\uACFC \uBCBD\uC5D0 \uCDA9\uB3CC\uD558\uBA74 \uD295\uAE30\uB294
      \uBC14\uC704\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000035
    m_Localized: "\uC801\uB4E4 \uC0AC\uC774\uB97C \uD295\uAE30\uBA70 \uACF5\uACA9\uD558\uB294
      \uC804\uAE30\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000036
    m_Localized: "\uBE44\uB97C \uB0B4\uB9AC\uB294 \uAD6C\uB984\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000037
    m_Localized: "\uC2E0\uBE44\uD55C \uB3C4\uAE68\uBE44\uBD88\uC744 \uBC1C\uC0AC\uD574
      \uC801\uC758 \uD1B5\uC81C\uAD8C\uC744 \uAC00\uC838\uC635\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000038
    m_Localized: "\uC801\uB4E4\uC744 \uAD11\uB780\uC2DC\uD0A4\uB294 \uD1A0\uD15C\uC744
      \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000039
    m_Localized: "\uC218\uB9AC\uD558\uB294 \uC774\uD30C\uB9AC\uB85C \uC544\uAD70
      \uAC74\uBB3C\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uACE0 \uC9C0\uC18D \uC2DC\uAC04\uC744
      \uB298\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000040
    m_Localized: "\uD558\uB298\uC5D0\uC11C \uBC14\uC704\uB97C \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000041
    m_Localized: "\uACF5\uC911\uC5D0\uC11C \uB2ED \uD2B9\uACF5\uB300\uB97C \uD22C\uC785\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000042
    m_Localized: "\uACFC\uC131\uC7A5\uC744 \uC77C\uC73C\uCF1C \uC791\uC740 \uC0DD\uBA85\uC744
      \uC131\uC7A5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000043
    m_Localized: "\uC8FC\uBCC0\uC5D0 \uBD88\uB369\uC774\uB97C \uBFDC\uB294 \uBD84\uD654\uAD6C\uB97C
      \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000044
    m_Localized: "\uAC74\uBB3C\uC744 \uC88B\uC544\uD558\uB294 \uAC81\uC7C1\uC774
      \uC804\uAE30 \uC950\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000045
    m_Localized: "\uC544\uAD70\uC744 \uB04C\uC5B4\uBAA8\uC73C\uB294 \uD683\uBD88\uC744
      \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000046
    m_Localized: "\uC804\uAE30 \uD3ED\uBC1C\uB85C \uC8FC\uBCC0 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000047
    m_Localized: "\uB0A0\uCE74\uB85C\uC6B4 \uB3CC\uD48D\uC744 \uC18C\uD658\uD574
      \uC9C0\uC18D\uC801\uC73C\uB85C \uC801\uB4E4\uC744 \uD0C0\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000048
    m_Localized: "\uC544\uAD70\uC744 \uBCF4\uD638\uD558\uB294 \uAC70\uD488 \uC0DD\uC131\uAE30\uB97C
      \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000049
    m_Localized: "\uD295\uAE30\uB294 \uC804\uAE30\uB97C \uBC1C\uC0AC\uD558\uB294
      \uC804\uAE30 \uD0C0\uC6CC\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864653363056640
    m_Localized: "\uBD88\uAF43 \uC62C\uCC59\uC774\uC640 \uBC88\uAC1C \uC62C\uCC59\uC774\uB97C
      \uC8FC\uAE30\uC801\uC73C\uB85C \uC18C\uD658\uD558\uB294 \uCC28\uC6D0 \uB450\uAEBC\uBE44\uB97C
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864718152470528
    m_Localized: "\uC801\uB4E4\uC744 \uACF5\uACA9\uD558\uB294 \uBD88\uAF43 \uC544\uAE30
      \uC815\uB839\uC744 \uC8FC\uAE30\uC801\uC73C\uB85C \uC18C\uD658\uD558\uB294
      \uBD88\uAF43 \uAD70\uC8FC \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864733830778880
    m_Localized: "\uACF5\uC911\uC720\uB2DB\uC744 \uD3ED\uBC1C\uD558\uB294 \uAC70\uD488\uC73C\uB85C
      \uACF5\uACA9\uD558\uB294 \uAC70\uD488 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864741510549504
    m_Localized: "\uBC94\uC704 \uB0B4 \uC720\uB2DB\uB4E4\uC5D0\uAC8C \uAC15\uB825\uD55C
      \uAC10\uC804\uACFC \uACF5\uC911 \uC720\uB2DB\uC5D0 \uD6A8\uACFC\uC801\uC778
      \uD3ED\uBC1C\uC744 \uC77C\uC73C\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507520
    m_Localized: "\uACF5\uC911 \uC720\uB2DB\uC744 \uACF5\uACA9\uD558\uB294 \uD3EC\uD0D1\uC744
      \uB4F1\uC5D0 \uC778 \uAF2C\uB9C8 \uB3CC \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
